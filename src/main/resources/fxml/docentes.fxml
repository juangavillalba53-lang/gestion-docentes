<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ar.edu.ipesmi.docentes.vista.DocentesController"
      spacing="18" styleClass="contenido">
    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

    <VBox spacing="8" styleClass="tarjeta" prefWidth="300" minWidth="280">
        <Label fx:id="lblFormulario" text="Nuevo docente" styleClass="titulo-tarjeta"/>
        <Label text="Nombre" styleClass="etiqueta"/>
        <TextField fx:id="txtNombre" promptText="Ej: Ana Gómez"/>
        <Label text="Email" styleClass="etiqueta"/>
        <TextField fx:id="txtEmail" promptText="ana@ipesmi.edu.ar"/>
        <Label text="Especialidad" styleClass="etiqueta"/>
        <TextField fx:id="txtEspecialidad" promptText="Ej: Programación"/>
        <HBox spacing="8" styleClass="fila-botones">
            <Button minWidth="-Infinity" text="Nuevo" onAction="#onNuevo" styleClass="boton-secundario"/>
            <Button minWidth="-Infinity" text="Guardar" onAction="#onGuardar" styleClass="boton-primario" defaultButton="true"/>
            <Button minWidth="-Infinity" text="Eliminar" onAction="#onEliminar" styleClass="boton-peligro"/>
        </HBox>
        <Label fx:id="lblMensaje" wrapText="true" styleClass="mensaje"/>
    </VBox>

    <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS">
        <Label text="Docentes" styleClass="titulo-tarjeta"/>
        <TableView fx:id="tablaDocentes" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <placeholder><Label text="No hay docentes cargados"/></placeholder>
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" maxWidth="70"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="210"/>
                <TableColumn fx:id="colEspecialidad" text="Especialidad" prefWidth="150"/>
                <TableColumn fx:id="colCarga" text="Carga (hs)" prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>
</HBox>
